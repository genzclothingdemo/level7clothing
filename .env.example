# ============================================================
#  Level7 Clothing — environment variables
#  Copy this file to .env and fill in your own values.
# ============================================================

# --- Database (required) ---------------------------------------------------
# From Vercel Postgres / Neon. Use the POOLED url for DATABASE_URL and the
# DIRECT (non-pooled) url for DIRECT_URL (used by Prisma migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Admin login (required) ------------------------------------------------
# A long random string that signs the admin session cookie.
AUTH_SECRET="change-me-to-a-long-random-string"
# The first admin account (created by the seed script; also a login fallback).
ADMIN_EMAIL="admin@level7clothing.com"
ADMIN_PASSWORD="a-strong-password"

# --- Email notifications (optional but recommended) ------------------------
# Get a free key at https://resend.com. Without it, emails are skipped.
RESEND_API_KEY=""
# The "from" address. Use onboarding@resend.dev to start, or your own verified domain.
# MUST be an address on a domain you have VERIFIED in Resend (Domains tab).
# A gmail.com / outlook.com address will be rejected on every send — you cannot
# verify a domain you don't own. Resend's onboarding@resend.dev works only for
# testing and can only deliver to your own Resend account email.
EMAIL_FROM="Level7 Clothing <hello@level7clothing.shop>"

# --- Image uploads (optional) ----------------------------------------------
# Create a Vercel Blob store; Vercel injects this automatically on deploy.
# Locally, copy it from the Vercel dashboard. Without it, paste image URLs.
BLOB_READ_WRITE_TOKEN=""

# --- Razorpay (online payments, optional) ----------------------------------
# From the Razorpay dashboard → Settings → API Keys. Use rzp_test_* while
# testing, rzp_live_* in production. Without these, only COD is offered.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Same as RAZORPAY_KEY_ID — exposed to the browser to open the payment popup.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- NimbusPost (delivery / shipping) --------------------------------------
# Partner API v2. Auth is an API KEY PAIR sent as two headers — NOT a bearer
# token and NOT your email/password (those were the old v1 API, which accounts
# created on the new platform cannot log into at all).
# Mint the pair at ship.nimbuspost.com → Settings → API Keys, role = "admin"
# ("viewer" keys get 401 on anything that creates or books). The secret is shown
# only once. Both are REQUIRED — shipping is disabled unless both are set.
NIMBUSPOST_API_KEY=""
NIMBUSPOST_API_SECRET=""
# Default parcel size/weight for shipments (grams / cm).
NIMBUSPOST_DEFAULT_WEIGHT="300"
NIMBUSPOST_DEFAULT_LENGTH="30"
NIMBUSPOST_DEFAULT_BREADTH="24"
NIMBUSPOST_DEFAULT_HEIGHT="3"
# Pickup warehouse name exactly as configured in the NimbusPost dashboard.
NIMBUSPOST_WAREHOUSE_NAME=""
# Webhook secret — choose any long random string, then paste the SAME value
# into ship.nimbuspost.com → Settings → Webhook → Secret field.
# Without this, POST /api/webhooks/nimbuspost returns 403 (disabled).
NIMBUSPOST_WEBHOOK_SECRET=""

# --- Public site origin (SEO) ---------------------------------------------
# Canonical origin, no trailing slash. Drives metadataBase, sitemap.xml,
# robots.txt, canonical tags, JSON-LD and OG image URLs. MUST be set in Vercel
# or the live site will emit localhost URLs to Google.
# Must match the PRIMARY domain in Vercel exactly (www vs apex matters — if the
# canonical points at a host that 301s, Google follows the redirect and your
# canonical is ignored). No trailing slash; siteUrl() strips one anyway.
NEXT_PUBLIC_SITE_URL="https://www.level7clothing.shop"

# Protects the automatic NimbusPost sync at /api/cron/nimbus-sync.
# Set the same value in Vercel so its cron scheduler can authenticate.
CRON_SECRET=""
