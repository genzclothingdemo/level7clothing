# ============================================================
#  Level7 Clothing — environment variables
#  Copy this file to .env and fill in your own values.
# ============================================================

# --- Database (required) ---------------------------------------------------
# Use the POOLED url for DATABASE_URL and the DIRECT (non-pooled) url for
# DIRECT_URL (used only by Prisma migrations / `db push`).
#
# On Supabase, copy both from: Project Settings -> Database -> Connection string
#   - DATABASE_URL  = "Connection pooling" / Transaction mode, port 6543,
#                     username is `postgres.<project-ref>`
#   - DIRECT_URL    = "Direct connection", port 5432
#
# IMPORTANT for Vercel: DATABASE_URL must be the pooler host
# (aws-N-<region>.pooler.supabase.com). The direct host db.<ref>.supabase.co is
# IPv6-only and Vercel's serverless functions have no outbound IPv6 — using it
# makes every page 500 with "Can't reach database server".
# Prisma also needs `?pgbouncer=true` in transaction mode (it disables prepared
# statements); `connection_limit=1` keeps each serverless instance to one conn.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# --- Admin login (required) ------------------------------------------------
# A long random string that signs the admin session cookie.
AUTH_SECRET="change-me-to-a-long-random-string"
# The first admin account (created by the seed script; also a login fallback).
ADMIN_EMAIL="admin@level7clothing.com"
ADMIN_PASSWORD="a-strong-password"

# --- Email notifications (optional but recommended) ------------------------
# Get a free key at https://resend.com. Without it, emails are skipped.
RESEND_API_KEY=""
# The "from" address. Use onboarding@resend.dev to start, or your own verified domain.
EMAIL_FROM="Level7 Clothing <onboarding@resend.dev>"

# --- Image uploads (optional) ----------------------------------------------
# Create a Vercel Blob store; Vercel injects this automatically on deploy.
# Locally, copy it from the Vercel dashboard. Without it, paste image URLs.
BLOB_READ_WRITE_TOKEN=""

# --- Razorpay (online payments, optional) ----------------------------------
# From the Razorpay dashboard → Settings → API Keys. Use rzp_test_* while
# testing, rzp_live_* in production. Without these, only COD is offered.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Same as RAZORPAY_KEY_ID — exposed to the browser to open the payment popup.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- NimbusPost (delivery / shipping) --------------------------------------
# NimbusPost's API logs in with your account EMAIL + PASSWORD (ship.nimbuspost.com).
# If 2FA / OTP is enabled on your account, copy your API token from
# ship.nimbuspost.com → Settings → API Settings and set NIMBUSPOST_TOKEN below.
NIMBUSPOST_TOKEN=""
NIMBUSPOST_EMAIL=""
NIMBUSPOST_PASSWORD=""
NIMBUSPOST_API_KEY=""
NIMBUSPOST_API_SECRET=""
# Default parcel size/weight for shipments (grams / cm).
NIMBUSPOST_DEFAULT_WEIGHT="300"
NIMBUSPOST_DEFAULT_LENGTH="30"
NIMBUSPOST_DEFAULT_BREADTH="24"
NIMBUSPOST_DEFAULT_HEIGHT="3"
# Pickup warehouse name exactly as configured in the NimbusPost dashboard.
NIMBUSPOST_WAREHOUSE_NAME=""
# Webhook secret — choose any long random string, then paste the SAME value
# into ship.nimbuspost.com → Settings → Webhook → Secret field.
# Without this, POST /api/webhooks/nimbuspost returns 403 (disabled).
NIMBUSPOST_WEBHOOK_SECRET=""

# --- Public site URL (used for sitemap, robots.txt, OG tags) ---------------
# Set this to your real domain in production, e.g. https://level7clothing.com
NEXT_PUBLIC_SITE_URL=""
