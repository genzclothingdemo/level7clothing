# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.claude/

# Scratch scripts and database snapshots. The backups contain order PII and
# password hashes — this whole folder must never be committed. It was
# previously narrowed to backup-catalog-*.json, which let a full DB snapshot
# through as an untracked file ready to be pushed.
scripts/tmp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Env files. ORDER MATTERS: git applies the last matching pattern, so the
# `!.env.example` negation must stay AFTER every `.env*` rule or the template
# stops being tracked. Keep these two lines together and last.
.env*
!.env.example
