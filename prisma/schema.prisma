// Level7 Clothing — Prisma schema
// Database: PostgreSQL (Supabase). DATABASE_URL must use the pooler host;
// DIRECT_URL keeps the direct host and is only used by `prisma db push`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------- Products --------
model Product {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String
  category          String // primary category
  secondaryCategory String? // optional — lets a piece appear under a second category
  // Optional group inside the primary category ("Oversized Tees").
  // Null = the product is a one-off and sits directly on the category page.
  subcategoryId     String?
  subcategory       Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  tags              String[] @default([])
  // Per-product options/variants the customer chooses (Size, Type, Shape…).
  // Shape: [{ name, choices: [{ label, priceDelta, image? }] }]
  // `image` (optional) lets a choice swap the displayed photo (e.g. Shape: Circle).
  options           Json     @default("[]")
  // Optional exact price per full option-combination (overrides additive pricing).
  // Shape: [{ combo: { "Size": "S", "Type": "A" }, price: 2000 }]  (legacy)
  variantPrices     Json     @default("[]")
  // Flipkart-style variant matrix. Each combination has its own price,
  // availability and its own set of photos. Supersedes variantPrices when set.
  // Shape: [{ combo: { "Size": "4 inch", "Vatki": "1" }, price, available, images: [] }]
  variants          Json     @default("[]")
  attributes        Json     @default("[]")
  propertyModules   Json     @default("{}")
  rules             Json     @default("{}")
  sellableVariants  Json     @default("[]")
  price             Int // whole rupees
  compareAtPrice    Int? // optional "was" price for showing a discount
  images            String[] @default([])
  stock             Int      @default(0)
  // Which checkout modes this product allows — subset of:
  // "prepaid" (full online), "cod" (cash on delivery),
  // "partial" (online advance + rest COD), "direct" (no payment, just placed).
  paymentModes      String[] @default(["prepaid", "cod"])
  advancePercent    Int? // % of line total taken online when "partial" is enabled
  // Optional parcel size for shipping (overrides NIMBUSPOST_DEFAULT_* when set).
  weightGrams       Int? // per-unit weight in grams
  lengthCm          Int?
  breadthCm         Int?
  heightCm          Int?
  shippingType      String   @default("nimbus") // "free", "fixed", "nimbus"
  shippingFee       Int      @default(0)
  shippingMarkup    Int      @default(0)
  // Product-page info blocks. NULL = inherit the store-wide default from
  // SiteSettings (defaultMaterialsCare / defaultShippingInfo / defaultReturnsInfo);
  // a string here overrides it for this product only. One line per bullet.
  materialsCare     String?
  shippingInfo      String?
  returnsInfo       String?
  // NULL = inherit SiteSettings.defaultReturnable. False marks a piece
  // non-returnable (customised / personalised work).
  returnable        Boolean?
  // Made-to-order / personalised piece. Drives three things: the storefront
  // explains why the payment options differ, the order is flagged for the
  // admin as needing customisation details, and returns default to off.
  isCustomisable    Boolean  @default(false)
  // What the customer has to supply (name, number, measurements…). Shown on
  // the product page and copied onto the order so the admin has it to hand.
  customisationNote String?
  // Social/video links shown as "Video previews" under the info accordion.
  // Shape: [{ title, url }] — YouTube, Instagram reels, packaging clips.
  videos            Json     @default("[]")
  isFeatured        Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category])
  @@index([secondaryCategory])
  @@index([subcategoryId])
  @@index([isActive])

  productImages     ProductImage[]
  reviews           Review[]
}

// -------- Orders --------
model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  userId        String? // linked customer account (null for legacy/guest)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName  String
  email         String
  phone         String
  address       String
  city          String
  state         String
  pincode       String
  items         Json // [{ productId, name, image, price, quantity }]
  subtotal      Int
  shipping      Int      @default(0)
  total         Int
  paymentMethod String   @default("COD") // COD | Razorpay | Partial | Direct
  paymentStatus String   @default("pending") // pending | paid | partial | failed
  amountPaid    Int      @default(0) // collected online (advance or full)
  balanceDue    Int      @default(0) // remaining to collect (COD / on delivery)
  status        String   @default("pending") // pending | confirmed | shipped | delivered | cancelled
  // -------- Online payment (Razorpay) --------
  razorpayOrderId   String? // Razorpay order id (order_...), set when an online payment is initiated
  razorpayPaymentId String? // Razorpay payment id (pay_...), set after a verified payment
  // -------- Fulfilment / tracking (managed by admin) --------
  courier         String? // e.g. Delhivery, BlueDart, India Post
  trackingNumber  String? // AWB / tracking number
  trackingUrl     String? // optional courier tracking link
  nimbusShipmentId String? // NimbusPost shipment/order id, set when shipped via NimbusPost
  // Courier the admin picked while reviewing rates, before the draft is booked.
  nimbusCourierId   String?
  nimbusCourierName String?
  deliveryStatus  String? // latest raw courier status from NimbusPost (e.g. "In Transit")
  deliveryLocation String? // where the parcel was last scanned
  deliveryStatusAt DateTime? // when that status was reported by the courier
  lastSyncedAt     DateTime? // last time the auto-sync polled NimbusPost
  statusHistory  Json     @default("[]") // [{ status, note, at }] appended on each admin update
  note          String?
  // True when any line item was a customisable product. Denormalised at
  // checkout so the orders list can flag "needs customisation" without
  // loading every product behind it.
  needsCustomisation Boolean @default(false)
  // A note the admin writes *for the customer*, shown highlighted on their
  // order page. Deliberately separate from `note`, which is internal.
  customerNote  String?
  // What the CUSTOMER typed at checkout ("leave with the neighbour").
  //
  // This used to share `note` with the admin's private note: checkout wrote
  // the buyer's text there and the admin's own note then overwrote it. That is
  // why `note` could never be shown to anyone safely. Three distinct things,
  // three columns: buyerNote (them → us), customerNote (us → them), note
  // (internal, never rendered).
  buyerNote     String?
  couponCode    String?
  discountTotal Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  returnRequests ReturnRequest[]

  @@index([status])
  @@index([userId])
}

// -------- Customer accounts --------
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  phone            String?
  // Saved default shipping address (prefilled at checkout, remembered per order).
  address          String?
  city             String?
  state            String?
  pincode          String?
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  orders           Order[]
  addresses        Address[]
  chatThreads      ChatThread[]
  wishlist         WishlistItem[]
  pushSubscriptions PushSubscription[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// One customer's conversation with the store.
///
/// Keyed by account when signed in, and by a `guestKey` cookie otherwise, so a
/// guest keeps their history and the thread can be claimed onto their account
/// when they later sign in. Replaces the old one-way Message/Inquiry inbox.
model ChatThread {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Anonymous browser identity. Unique so a cookie maps to exactly one thread.
  guestKey      String?  @unique
  name          String?
  email         String?
  phone         String?
  // Denormalised so the admin inbox can sort and badge without aggregating
  // the whole message table on every page load.
  lastMessageAt DateTime @default(now())
  lastMessage   String?
  adminUnread   Int      @default(0)
  userUnread    Int      @default(0)
  isClosed      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages ChatMessage[]

  @@index([lastMessageAt])
  @@index([userId])
}

model ChatMessage {
  id             String     @id @default(cuid())
  threadId       String
  thread         ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  // "user" | "admin" — who typed it.
  sender         String
  body           String
  // WhatsApp-style delivery state: sent -> delivered -> seen. "pending" only
  // exists client-side while the request is in flight; it is never persisted.
  status         String     @default("sent")
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  seenAt         DateTime?
  createdAt      DateTime   @default(now())

  @@index([threadId, createdAt])
}

// -------- Saved shipping addresses (address book) --------
// Level7-only model. It does not exist in the upstream store this repo was
// forked from, so a wholesale schema copy silently drops it — and
// `prisma db push` would then DROP the live table with its data. Keep it.
model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Home") // Home | Work | Other — customer's own name for it
  fullName  String
  phone     String
  address   String
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// -------- Newsletter --------
// Level7-only model — same warning as Address above.
model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  source       String   @default("footer") // where they signed up from
  unsubscribed Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([unsubscribed])
}

// -------- Leads (interested customers / add-to-cart) --------
model Lead {
  id           String   @id @default(cuid())
  productId    String?
  productName  String
  productImage String?
  quantity     Int      @default(1)
  price        Int?
  visitorId    String?
  email        String?
  name         String?
  phone        String?
  status       String   @default("interested") // interested | contacted | ordered | lost
  notes        String? // admin's follow-up notes from contacting the customer
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())

  @@index([status])
}

// -------- Contact messages / inquiries --------
model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
}

// -------- Site settings (branding + contact), single row --------
model SiteSettings {
  id                    String   @id @default("main")
  brandName             String   @default("Level7 Clothing")
  tagline               String   @default("Premium GenZ Graphic Tees")
  logoUrl               String?
  heroHeadline          String   @default("Wear the statement.")
  heroSubtext           String   @default("Premium oversized tees and drop-shoulder hoodies — quality and design that enhance your everyday.")
  aboutText             String   @default("Level7 Clothing is a contemporary apparel brand focused on quality and design. We curate graphic tees and hoodies that enhance your everyday.")
  contactEmail          String   @default("hello@level7clothing.example")
  contactPhone          String   @default("+91 90000 00000")
  whatsapp              String?  @default("+919000000000")
  address               String?  @default("Level7 Clothing, India")
  instagram             String?  @default("https://instagram.com")
  facebook              String?  @default("")
  adminNotifyEmail      String   @default("admin@level7clothing.example")
  currency              String   @default("INR")
  freeShippingThreshold Int? // free shipping above this order value
  razorpayEnabled       Boolean  @default(false) // master switch for online payments
  nimbusEnabled         Boolean  @default(false) // master switch for NimbusPost shipping
  // Per-method availability (each shown at checkout only when ON + product allows it).
  codEnabled            Boolean  @default(true)  // Cash on Delivery
  prepaidEnabled        Boolean  @default(true)  // Prepaid (full online) — needs Razorpay
  partialEnabled        Boolean  @default(true)  // Advance + COD — needs Razorpay
  directEnabled         Boolean  @default(true)  // Customised order (pay to owner)
  announcement          String?  @default("Join the club — exclusive deals and early access to new drops")
  // ---- Product defaults ----
  // Store-wide copy for the product page's info accordion. Every product uses
  // these unless it sets its own (Product.materialsCare / shippingInfo /
  // returnsInfo). One line per bullet; blank hides the section entirely.
  defaultMaterialsCare  String   @default("Premium heavyweight cotton, pre-shrunk and bio-washed\nMachine wash cold, inside out, with like colours\nDo not bleach or tumble dry — hang to dry\nWarm iron on the reverse; never iron directly on the print")
  defaultShippingInfo   String   @default("Free shipping across India on every order\nDispatched in 1–2 working days, tracking shared on dispatch\nCash on Delivery available on eligible pin codes")
  defaultReturnsInfo    String   @default("7-day easy returns on unworn items with tags attached.\nWrong size? Exchange it once, free of charge.\nApproved refunds go back to the original payment method within 5–7 working days.")
  // ---- Returns ----
  // Master switch: OFF hides the request form everywhere, whatever a product says.
  returnsEnabled        Boolean  @default(true)
  // Applies to every product that hasn't set Product.returnable.
  defaultReturnable     Boolean  @default(true)
  // Days after delivery a request can still be raised.
  returnWindowDays      Int      @default(7)
  // Which reasons a customer may choose when raising a return. Admin-editable
  // so the accepted grounds are a policy decision, not a code change. Empty
  // falls back to RETURN_REASONS in lib/returns.ts.
  returnReasons         String[] @default(["Wrong size", "Damaged or defective", "Wrong item delivered", "Not as described", "Changed my mind"])
  // Shown above the return form — the plain-English policy the customer agrees to.
  returnPolicyNote      String   @default("Items must be unworn, unwashed and returned with their original tags.\nRaise the request within the return window shown on your order.\nCustomised pieces cannot be returned unless they arrived damaged.")
  // ---- Order confirmation pipeline ----
  //
  // How a freshly placed order reaches "confirmed":
  //   "manual"    — everything lands in pending; a human confirms. Safest.
  //   "byPayment" — decided per payment method by the three flags below, so a
  //                 paid order can skip the queue while COD still gets a call.
  //   "auto"      — everything confirms itself. Fastest, and the only mode
  //                 where a fake COD order can reach a courier untouched.
  orderConfirmMode     String  @default("manual")
  autoConfirmPrepaid   Boolean @default(true)
  autoConfirmPartial   Boolean @default(true)
  autoConfirmCod       Boolean @default(false)

  // ---- Shipment pipeline ----
  //
  // OFF (default): confirming an order stages an unbooked NimbusPost draft and
  // stops, so a human picks the courier and sees the cost before the wallet is
  // charged. ON: the draft is booked immediately with `autoShipCourier`.
  //
  // Deliberately default-off. CLAUDE.md records the draft-first review gate as
  // intentional, and booking spends real money.
  autoShipOnConfirm    Boolean @default(false)
  // "cheapest" | "fastest" — how the courier is picked when auto-shipping.
  autoShipCourier      String  @default("cheapest")

  // ---- Refunds ----
  // What the store keeps when it refunds. Applied to prepaid and COD orders;
  // both can be set and are summed. Zero = full refund.
  refundFeePercent      Int      @default(0)
  refundFeeFlat         Int      @default(0)
  // Partial orders: is the online advance returned? Default false, because the
  // advance is what commits a made-to-order piece to production — and the
  // checkout copy already tells the customer it is non-refundable.
  partialAdvanceRefundable Boolean @default(false)
  // Never charge the customer for the store's own mistake. When the reason is
  // damaged/wrong item, the fee is waived regardless of the two values above.
  waiveRefundFeeOnOurFault Boolean @default(true)
  // Shown on the return form and the refund summary.
  refundPolicyNote      String   @default("Prepaid orders are refunded to the original payment method within 5–7 working days.\nCash-on-delivery orders are refunded by UPI — we'll ask for your UPI ID once the return is approved.\nOn part-paid orders the online advance is not refundable; the balance was never collected.")
  updatedAt             DateTime @updatedAt
}

// -------- Admin users --------
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

// -------- Categories --------
model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  slug          String        @unique
  imageUrl      String?
  sortOrder     Int           @default(0)
  subcategories Subcategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// -------- Subcategories (a "group" shown in place of its products) --------
// A subcategory is the middle shelf: "T-Shirts" (category) →
// "Oversized Tees" (subcategory) → the individual tees (products).
// On the storefront it is displayed like a product card — name, photo,
// price range — but clicking it opens the list of real products inside.
// A subcategory holding a single product collapses to that product instead,
// so one-off pieces never make the customer click twice.
model Subcategory {
  id         String   @id @default(cuid())
  name       String
  slug       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // 1–2 cover photos. Left empty, the storefront borrows photos from the
  // products inside — so the same file is never uploaded twice.
  images     String[] @default([])
  // Optional manual price range. Left null, it is computed live from the
  // products inside (min–max), so it can never drift out of date.
  priceMin   Int?
  priceMax   Int?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  products   Product[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isActive])
}

// -------- Customer Reviews --------
model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?  // null = guest / manually added
  name      String   // reviewer display name
  email     String?  // contact for follow-up; never shown publicly
  rating    Int      // 1–5 stars
  title     String?  // short headline
  body      String   // review text
  approved  Boolean  @default(false) // admin must approve before public display
  featured  Boolean  @default(false) // pinned to the top of the product's reviews
  // Set when the reviewer has a delivered order containing this product — shown
  // as a "Verified buyer" badge. Never self-declared by the reviewer.
  verified  Boolean  @default(false)
  // Private reply/reason the admin recorded when moderating.
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([approved])
  @@index([featured])
  @@index([productId, approved])
  @@index([createdAt])
}

// -------- Returns --------
// A customer's request to send a delivered item back. Kept separate from Order
// so one order can have several independent requests (different items, or a
// second attempt after a rejection).
model ReturnRequest {
  id            String   @id @default(cuid())
  // Human-quotable reference (RET-XXXXXX) — what support asks for on the phone.
  requestNumber String   @unique
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Order.items is JSON, so the line is captured by value — a later product
  // rename or price change must not rewrite what was actually returned.
  productId     String?
  productName   String
  variantLabel  String?  // e.g. "Design: Pink · Size: 8\""
  quantity      Int      @default(1)
  unitPrice     Int      @default(0)
  reason        String   // see RETURN_REASONS in lib/returns.ts
  customerNote  String?
  images        String[] @default([]) // unboxing / damage photos from the customer
  status        String   @default("pending") // see RETURN_STATUSES in lib/returns.ts
  // Shown to the customer on the order page — the decision explained.
  adminNote     String?
  // Net amount actually returned to the customer (gross line value minus
  // refundFee, and minus a non-refundable advance on partial orders).
  refundAmount  Int?
  refundMethod  String?  // "original" | "upi" | "replacement" | "none"
  // Gross value of the returned lines, and what the store kept. Stored rather
  // than recomputed so a later change to the fee settings cannot silently
  // rewrite the history of a refund that already went out.
  refundGross   Int?
  refundFee     Int?
  // Where a non-original refund goes. UPI only, on purpose: a UPI handle is
  // routinely shared and is not, by itself, enough to move money. Full bank
  // account numbers are deliberately NOT stored here — that is a different
  // class of data and would need encryption and a retention policy first.
  refundUpi     String?
  // Bank/UPI reference (UTR) the admin records once the money is sent, so the
  // customer can be told exactly what to look for on their statement.
  refundReference String?
  refundedAt    DateTime?
  // ---- Reverse pickup (NimbusPost) ----
  nimbusOrderId String?  // draft reverse order id
  nimbusAwb     String?  // AWB once the reverse shipment is booked
  nimbusCourier String?
  // Last reverse-pickup failure, surfaced in the admin so a silent Nimbus error
  // can't leave an approved return with no pickup booked.
  nimbusError   String?
  statusHistory Json     @default("[]") // [{ status, note, at, by }]
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([orderId])
  @@index([createdAt])
}

// -------- Coupons --------
model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  discountAmount Int
  isPercentage   Boolean  @default(false)
  isActive       Boolean  @default(true)
  productIds     String[] @default([]) // empty = applies to the whole cart
  usageLimit     Int?     // Optional max times this coupon can be used
  usedCount      Int      @default(0)
  // Minimum cart subtotal (in whole rupees) before the code is accepted.
  minSpend       Int?
  // Ceiling on a percentage discount — "20% off, up to ₹300". Meaningless for
  // flat coupons, and ignored there rather than validated away, so switching a
  // coupon between flat and % doesn't lose the cap.
  maxDiscount    Int?
  // How many times ONE customer may use it (matched on user id, else email).
  perUserLimit   Int?
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  redemptions CouponRedemption[]

  @@index([isActive])
}

/// One accepted use of a coupon.
///
/// `Coupon.usedCount` alone cannot answer "has THIS person used it before",
/// which is what `perUserLimit` needs. Kept even if the order is later
/// cancelled — the limit is on redeeming, not on keeping.
model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId   String?
  userId    String?
  email     String?
  amount    Int      @default(0) // discount actually applied, in rupees
  createdAt DateTime @default(now())

  @@index([couponId, userId])
  @@index([couponId, email])
}

/// A saved product, per account.
///
/// The wishlist was localStorage-only, so it vanished on a new device and the
/// admin could never see it. Guests still use localStorage; signing in merges
/// those slugs in and the account becomes the source of truth from then on.
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stored by slug to match the storefront's own addressing, and so a deleted
  // product degrades to "no longer available" instead of a dangling join.
  slug      String
  createdAt DateTime @default(now())

  @@unique([userId, slug])
  @@index([userId])
}

/// An offer, sale or announcement the store is running.
///
/// One row drives both surfaces — the slim banner and the first-visit popup —
/// so the copy can never say two different things. `kind` decides where it
/// shows. Scheduling is on the row rather than done by switching rows on and
/// off by hand, because a sale that ends at midnight should stop by itself.
model Promotion {
  id         String   @id @default(cuid())
  title      String
  body       String
  ctaLabel   String?
  ctaHref    String?
  /// "banner" | "popup" | "both"
  kind       String   @default("banner")
  isActive   Boolean  @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  /// Highest priority wins when several are live. Ties break on most recent.
  priority   Int      @default(0)
  /// Days a dismissal sticks for. 0 = only for this browsing session.
  /// A popup that reappears on every page load is the fastest way to make
  /// someone leave, so dismissal is respected client-side and this sets how
  /// long for.
  dismissDays Int     @default(7)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, priority])
}

/// A browser that has granted push permission for this store.
///
/// Keyed by endpoint because that is what the push service issues and what
/// must be deleted when it returns 404/410 (subscription expired).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
}

// -------- Media --------
model Media {
  id               String   @id @default(cuid())
  url              String   @unique
  file             String
  alt              String?
  width            Int?
  height           Int?
  size             Int?
  source           String   // "repo", "blob", "external"
  tags             String[] @default([])
  roles            String[] @default([])
  // Smart variant tagging — optional. When set, the photo is automatically
  // suggested when the admin opens that variant's gallery in the picker.
  // e.g. variantAttribute = "Design", variantValue = "Pink"
  variantAttribute String?  // e.g. "Design"
  variantValue     String?  // e.g. "Pink"
  // Denormalised subcategory name for fast search without a join.
  subcategoryName  String?  // e.g. "Oversized Tees"
  createdAt        DateTime @default(now())

  productImages     ProductImage[]

  @@index([variantAttribute, variantValue])
  @@index([subcategoryName])
}

model ProductImage {
  id           String  @id @default(cuid())
  productId    String
  mediaId      String
  // variantValue = null  → common (shown for all variants)
  // variantValue = "Pink" → shown only when Design = Pink is selected
  variantValue String?
  slot         String  @default("gallery") // "preview", "gallery", "common"
  sortOrder    Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaId, variantValue])
  @@index([productId, variantValue])
}

// -------- Portfolio --------
// The admin-managed body of work shown at /portfolio: Instagram reels, blog
// posts, collaborations, bulk-order jobs. It replaces the hardcoded curated
// Instagram grid, and it is deliberately NOT Instagram-only.
//
// `productId` is a plain String, not a relation, on purpose: a portfolio entry
// must outlive the product it was about. A relation with onDelete: Cascade
// would silently delete the entry when the piece is retired, and Restrict would
// block the product delete entirely. See lib/portfolio.ts, which resolves the
// id and drops the link when the product is gone.
model PortfolioItem {
  id          String   @id @default(cuid())
  kind        String   @default("instagram") // "instagram" | "link" | "image" | "video"
  title       String
  description String?
  url         String? // permalink / blog / external
  imageUrl    String? // thumbnail or uploaded image
  embedHtml   String? // oEmbed/iframe html when available
  productId   String? // when this piece is about one product
  tags        String[] @default([])
  sortOrder   Int      @default(0)
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}
